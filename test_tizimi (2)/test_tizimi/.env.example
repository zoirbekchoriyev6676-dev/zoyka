# ========================================================
# ENTERPRISE TEST PLATFORMASI — PRODUCTION SOZLAMALARI
# Ushbu fayldan nusxa olib .env fayliga joylang va maxfiy kalitlarni to'ldiring.
# ========================================================

# 1. Google Gemini AI API kaliti (Google AI Studio yoki Cloud Console)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server sozlamalari
HOST=127.0.0.1
PORT=8000
RELOAD=false

# 3. CORS Xavfsizligi (Vergul bilan ajratilgan ruxsat etilgan domenlar)
# Ishlab chiqarishda faqat o'z domeningizni yozing:
CORS_ALLOWED_ORIGINS=https://test.maktab.uz,http://localhost:8000

# 4. Ma'lumotlar bazasi sozlamalari
# SQLite uchun (Development):
DATABASE_PATH=database/database.db

# PostgreSQL uchun (Production):
# DATABASE_URL=postgresql://app_user:kuchli_parol@127.0.0.1:5432/test_tizimi

# 5. JWT Xavfsizlik kaliti (HS256)
# Tavsiya: openssl rand -hex 32 yordamida yangi kalit generatsiya qiling
JWT_SECRET=generate_strong_64_character_hex_secret_key_here

# 6. Telegram Bot Sozlamalari (AI Exam Report Bot)
# @BotFather orqali olingan token:
BOT_TOKEN=your_telegram_bot_token_here
